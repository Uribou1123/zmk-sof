#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE       &kp N1  &kp N2            &kp N3    &kp N4        &kp N5                                                  &kp N6         &kp N7     &kp N8    &kp N9    &kp N0  &kp EQUAL
&kp TAB          &kp Q   &kp O             &kp U     &kp COMMA     &kp PERIOD                                              &kp Y          &kp W      &kp R     &kp J     &kp F   &kp BSPC
&lt 1 BACKSPACE  &kp X   &kp I             &kp E     &kp A         &kp MINUS                                               &kp K          &kp T      &kp N     &kp S     &kp P   &kp ENTER
&kp LSHFT        &kp H   &kp L             &kp Y     &kp V         &kp SLASH   &kp C_MUTE              &kp K_PLAY_PAUSE    &kp G          &kp D      &kp M     &kp Z     &kp B   &kp RSHFT
                         &kp LEFT_CONTROL  &kp LALT  &kp LEFT_WIN  &kp SPACE   &lt 1 LC(LANG_HANJA)    &lt 2 LANG_HANGEUL  &kt BACKSPACE  &kp RCTRL  &kp RALT  &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        lower_layer {
            display-name = "LOW";

            // ------------------------------------------------------------------------------------------------------------
            // | `     |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | RAISE |   1 |   2 |   3  |   4  |   5  |                   |   6  |   7   |   8   |   9  |    0  |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp ESC         &kp F1            &kp F2             &kp F3                &kp F4                 &kp F5                            &kp F6           &kp F7             &kp F8         &kp F9         &kp F10        &kp F11
&kp TAB         &kp EXCLAMATION   &kp AT_SIGN        &kp HASH              &kp DOLLAR             &kp PERCENT                       &kp DEL          &kp NUMBER_7       &kp N8         &kp N9         &kp COLON      &kp F12
&trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE                    &kp RIGHT_BRACE  &kp NUMBER_4       &kp N5         &kp NUMBER_6   &kp SEMICOLON  &kp PIPE
&kp LEFT_SHIFT  &kp LS(NUMBER_6)  &kp AMPERSAND      &kp ASTERISK          &kp EQUAL              &kp QUESTION    &trans    &trans  &kp N0           &kp NUMBER_1       &kp NUMBER_2   &kp NUMBER_3   &kp BSLH       &kp RIGHT_SHIFT
                                  &kp LCTRL          &kp LEFT_ALT          &kp LEFT_WIN           &kp SPACE       &trans    &trans  &kp BACKSPACE    &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_WIN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "RAI";

            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |     | INS  | PSCR | GUI   |       |      |                | PGUP |      |       |      |       |       |
            // |     | ALT  | CTRL | SHIFT |       | CAPS |                |  <-  |   v  |   ^   |  ->  |  DEL  | BKSPC |
            // |     | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //              |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4                      &trans          &trans          &trans          &trans           &trans    &trans
&trans      &none         &kp LEFT_ARROW  &kp UP_ARROW  &none            &none                             &msc SCRL_UP    &mkp LCLK       &mmv MOVE_UP    &mkp MB2         &mkp MB5  &trans
&trans      &none         &kp LCTRL       &none         &kp RIGHT_ARROW  &none                             &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB4  &none
&trans      &kp K_UNDO    &kp K_CUT       &kp K_COPY    &kp K_PASTE      &kp DOWN_ARROW  &trans    &trans  &trans          &msc SCRL_LEFT  &mkp MCLK       &msc SCRL_RIGHT  &trans    &trans
                          &trans          &trans        &trans           &trans          &trans    &trans  &trans          &trans          &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
